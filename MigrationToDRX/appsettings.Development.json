{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "NLog": {
    "rules": [
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "file,console"
      }
    ]
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:7040"
      },
      "Https": {
        "Url": "https://localhost:7041"
      }
    }
  },
  "AllowedHosts": "*"
}
