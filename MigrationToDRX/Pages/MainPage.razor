@page "/main"
@using MigrationToDRX.Data.Helpers
@using MigrationToDRX.Data.Models.ViewModels
@using MigrationToDRX.Data.Models.Dto
@using MigrationToDRX.Data.Services.Settings
@using Radzen
@using Radzen.Blazor
@using static MigrationToDRX.Data.Models.Dto.StageStatus

<RadzenDialog />

<PageTitle>Миграция данных в DirectumRX</PageTitle>

<div class="page-background-main">
    <RadzenComponents />

    <div class="row">
        @* Список этапов миграции слева *@
        <div class="col-md-3">
            <div class="card mb-3">
                <div class="card-header">
                    <h5>Этапы миграции</h5>
                    <button class="btn btn-primary btn-sm w-100 mt-2" @onclick="AddNewStage">
                        Добавить этап
                    </button>
                </div>
                <div class="card-body p-0">
                    @if (SettingStages.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var stage in SettingStages.OrderBy(s => s.Number))
                            {
                                <div class="list-group-item @(SelectedStage == stage ? "active" : "")"
                                     style="cursor: pointer;"
                                     @onclick="() => SelectStage(stage)">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="badge bg-secondary me-2">@stage.Number</span>
                                        <strong>@stage.Name</strong>
                                        @if (stage.Status == StageStatus.InProgress || stage.Status == StageStatus.Running)
                                        {
                                            <span class="badge bg-primary ms-auto">В процессе</span>
                                        }
                                        else if (stage.Status == StageStatus.Completed || stage.Status == StageStatus.Processed)
                                        {
                                            <span class="badge bg-success ms-auto">✓ Завершен</span>
                                        }
                                        else if (stage.Status == StageStatus.Error)
                                        {
                                            <span class="badge bg-danger ms-auto">✗ Ошибка</span>
                                        }
                                    </div>
                                    <small class="d-block text-truncate">@stage.Description</small>
                                    <small class="d-block">
                                        @stage.SourceType.GetDisplayName()
                                    </small>
                                    @if (isProceed && stage.ProgressPercent > 0 && (stage.Status == StageStatus.InProgress || stage.Status == StageStatus.Running || stage == SelectedStage))
                                    {
                                        <div class="progress mt-2" style="height: 5px;">
                                            <div class="progress-bar" role="progressbar"
                                                 style="width: @(stage.ProgressPercent)%"
                                                 aria-valuenow="@stage.ProgressPercent"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100"></div>
                                        </div>
                                        <small class="text-muted">@stage.ProgressPercent%</small>
                                    }
                                    @if (stage.LastExecutionTime.HasValue)
                                    {
                                        <div class="mt-2 pt-2 border-top">
                                            <small class="text-muted d-block">
                                                <strong>Последнее выполнение:</strong> @stage.LastExecutionTime.Value.ToString("dd.MM.yyyy HH:mm:ss")
                                            </small>
                                            @if (stage.LastProcessedRows.HasValue)
                                            {
                                                <small class="text-muted d-block">
                                                    Обработано: @stage.LastProcessedRows
                                                    @if (stage.LastSuccessfulRows.HasValue)
                                                    {
                                                        <span class="text-success"> (✓ @stage.LastSuccessfulRows)</span>
                                                    }
                                                    @if (stage.LastErrorRows.HasValue && stage.LastErrorRows > 0)
                                                    {
                                                        <span class="text-danger"> (✗ @stage.LastErrorRows)</span>
                                                    }
                                                </small>
                                            }
                                            @if (!string.IsNullOrEmpty(stage.LastExecutionResult))
                                            {
                                                <small class="text-muted d-block text-truncate" title="@stage.LastExecutionResult">
                                                    @stage.LastExecutionResult
                                                </small>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        @if (SelectedStage != null)
                        {
                            <div class="p-2 border-top">
                                <div class="btn-group w-100 mb-2" role="group">
                                    <button class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => MoveStageUp(SelectedStage)"
                                            disabled="@(SelectedStage.Number == 1)">
                                        ▲
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => MoveStageDown(SelectedStage)"
                                            disabled="@(SelectedStage.Number == SettingStages.Count)">
                                        ▼
                                    </button>
                                </div>
                                <button class="btn btn-sm btn-danger w-100"
                                        @onclick="() => DeleteStage(SelectedStage)">
                                    Удалить этап
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-3">
                            <p class="text-muted small mb-0">Нет настроенных этапов. Нажмите "Добавить этап".</p>
                        </div>
                    }
                </div>
                @if (SettingStages.Any())
                {
                    <div class="card-footer">
                        <div class="d-flex flex-column gap-2">
                            <button class="btn btn-primary w-100"
                                    @onclick="ExecuteAllStages"
                                    disabled="@(!SettingStages.Any() || isProceed)">
                                Запустить все этапы
                            </button>
                            @if (isProceed)
                            {
                                <button class="btn btn-danger w-100"
                                        @onclick="CancelOperation">
                                    Прервать выполнение
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Форма редактирования выбранного этапа справа *@
        <div class="col-md-9">
            @if (SelectedStage != null)
            {
        <div class="card">
            <div class="card-body">

                @* Название и описание этапа *@
                <div class="row mb-3">
                    <div class="col col-md-6">
                        <label class="form-label">Название этапа</label>
                        <RadzenTextBox @bind-Value="SelectedStage.Name" class="w-100" Placeholder="Введите название этапа..." />
                    </div>
                    <div class="col col-md-6">
                        <label class="form-label">Описание этапа</label>
                        <RadzenTextBox @bind-Value="SelectedStage.Description" class="w-100" Placeholder="Введите описание..." />
                    </div>
                </div>

                <div class="row">
                    <div class="col col-md-7">
                        <div class="mb-3">
                            <label class="form-label">Тип источника</label>
                            <RadzenDropDown Data="@SourceTypes"
                                            @bind-Value="SelectedSourceType"
                                            Placeholder="Выберите тип источника данных..."
                                            Style="width:100%"
                                            ValueProperty="Value"
                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            AllowFiltering="true"
                                            TextProperty="DisplayName">
                            </RadzenDropDown>
                            <RadzenRequiredValidator TValue="string" Required="true" Text="Тип источника должен быть выбран" />
                        </div>

                        @if (SelectedExcelSourceType())
                        {
                            @* Выбор файла *@
                            <label class="file-upload-label">Excel файл</label>
                            <div class="file-upload-container mb-3">
                                <RadzenUpload Accept=".xlsx,.xls,.odf,.ods,.csv"
                                              Multiple="false"
                                              ChooseText="Выбрать..."
                                              Change="@OnFileUpload"
                                              class="file-upload-control" />
                            </div>
                        }
                        else if (SelectedDatabaseMssqlSourceType())
                        {
                            <label class="form-label">Строка подключения к БД</label>
                            <div class="col">
                                <RadzenTemplateForm TItem="string">
                                    <div class="mb-3">
                                        <RadzenTextBox @bind-Value="@DbConnectionString" class="w-100"
                                                       Placeholder="Например: Server=myServerAddress;Database=myDataBase;User Id=myUsername;Password=myPassword;"/>
                                    </div>
                                    <button type="submit" class="btn btn-primary" style="width: auto;" @onclick="ConnectToDatabase" disabled="@string.IsNullOrWhiteSpace(@DbConnectionString)">
                                        Подключиться
                                    </button>
                                </RadzenTemplateForm>
                            </div>

                            @if (IsDbConnectionSuccess)
                            {
                                <div class="col">
                                    <label class="form-label">Таблица</label>
                                    <RadzenDropDown Data="@DbTables"
                                                    @bind-Value="SelectedTable"
                                                    Placeholder="Выберите таблицу из которой будут загружены данные..."
                                                    Style="width:100%"
                                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                    AllowFiltering="true"
                                                    Change="@OnDbTableChanged">
                                    </RadzenDropDown>
                                </div>

                                <div class="col">
                                    <label class="form-label">Подзапрос фильтрации</label>
                                    <RadzenTextBox @bind-Value="@FilterSubquery" class="w-100" Placeholder="Подзапрос фильтрации" />
                                </div>
                            }
                        }
                    </div>
                    <div class="col col-md-5">
                        @* Выбор операции *@
                        <div class="mb-3">
                            <label class="form-label">Операция</label>
                            <RadzenDropDown Data="@OperationItems"
                                            @bind-Value="SelectedOperation"
                                            Change="OnSelectedOperationChanged"
                                            Placeholder="Выберите операцию с данными..."
                                            Style="width:100%"
                                            ValueProperty="Value"
                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            AllowFiltering="true"
                                            TextProperty="DisplayName">
                            </RadzenDropDown>
                            <RadzenRequiredValidator TValue="string" Required="true" Text="Операция должна быть выбрана" />
                        </div>
                        @* Чекбокс для расширенных операций *@
                        <div class="mb-3">
                            <label class="d-flex align-items-center" style="gap:5px;">
                                <RadzenCheckBox @bind-Value="EnableExtendedOperations"
                                                TValue="bool"
                                                Change="OnExtendedOperationsChanged" />
                                <span>Пакет разработки для DRX <code>MigrationToDRX</code></span>
                            </label>
                            <small class="text-muted">Включает дополнительные операции миграции</small>
                        </div>
                    </div>
                </div>

                @if(RequiresEntitySelection())
                {
                    <div class="row">
                        <div class="col col-md-7">
                            @* Выбор сущности *@
                            <div class="mb-3">
                                <label class="form-label">Сущность в Odata</label>
                                <RadzenDropDown TextProperty="Name"
                                                Data="@EntitySets"
                                                @bind-Value="SelectedEntitySet"
                                                Placeholder="Выберите сущность..."
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                AllowClear="true"
                                                AllowFiltering="true"
                                                Style="width:100%"
                                                Change="OnSelectedEntitySetChanged">
                                </RadzenDropDown>
                                <RadzenRequiredValidator TValue="string" Required="true" Text="Сущность должна быть выбрана" />
                            </div>

                            <button class="btn btn-success" @onclick="SaveStageSettings">
                                Сохранить настройки этапа
                            </button>
                        </div>

                        <div class="col col-md-5">
                            @* Выбор ключа для всех связанных сущностей *@
                            <div class="mb-3">
                                <label class="form-label">Поиск связанных сущностей по:</label>
                                <RadzenDropDown Data="@SearchEntityByList"
                                                @bind-Value="SearchCriteria"
                                                Placeholder="Выберите из списка..."
                                                Style="width:100%"
                                                ValueProperty="Value"
                                                TextProperty="DisplayName">
                                </RadzenDropDown>
                                <RadzenRequiredValidator TValue="string" Required="true" Text="Критерий поиска должен быть выбран" />
                            </div>
                        </div>
                    </div>
                }

                <div class="row">
                    <div class="col col-md-7">
                        @* Контрол появляется только в том случае, если у выбранной сущности есть свойства-коллекции
                        и выбрана одна из операций работы со свойствами-коллекциями *@
                        @if(CollectionProperties.Any() && OdataOperationHelper.OperationsWithCollections.Contains(SelectedOperation))
                        {
                            @* Выбор свойства - коллекции *@
                            <div class="mb-3">
                                <label class="form-label">Свойство - коллекция</label>
                                <RadzenDropDown TextProperty="Name"
                                                Data="@CollectionProperties"
                                                @bind-Value="SelectedCollectionProperty"
                                                Placeholder="Выберите сущность..."
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                AllowClear="true"
                                                AllowFiltering="true"
                                                Style="width:100%"
                                                Change="OnSelectedCollectionPropertyChanged">
                                </RadzenDropDown>
                            </div>
                        }
                    </div>
                    <div class="col col-md-5">
                        <!-- 📊 Количество строк -->

                    </div>
                </div>

                @* Кнопка скачивания отчета *@
                <div class="mb-3 d-flex justify-content-end w-60">
                    <button class="btn btn-outline-secondary mx-1"
                            @onclick="DownloadExcel"
                            disabled="@(ColumnMappings.Any(m => m.Value != null) == false)">
                        Скачать протокол миграции
                    </button>
                </div>

                @if (PreviewRows.Any())
                {
                    @* Предпросмотр таблицы *@
                    <RadzenDataGrid Data="@PreviewRows"
                                    @ref="@dataGrid"
                                    TItem="Dictionary<string, string>"
                                    AllowColumnResize="true"
                                    AllowColumnReorder="true"
                                    AllowColumnPicking="true"
                                    ColumnsText="выбор columns (колонок)"
                                    ShowR
                                    AllowPaging="true"
                                    AllColumnsText="Все колонки"
                                    ColumnsPickerAllowFiltering="true"
                                    ColumnsShowingText="columns отображается"
                                    PageSize="100" >

                        <HeaderTemplate>
                            <button class="btn btn-outline-secondary" @onclick="RemoveMapping">
                                Очистить выбранные свойства
                            </button>
                        </HeaderTemplate>

                        <Columns>
                            <RadzenDataGridColumn Width="50px" Title="#" Filterable="false" Sortable="false" TextAlign="TextAlign.Center">
                                <Template Context="data">
                                    @(dataGrid?.View.ToList().IndexOf(data) + 1)
                                </Template>
                            </RadzenDataGridColumn>

                            @foreach (var col in TableColumns)
                            {
                                <RadzenDataGridColumn TItem="Dictionary<string,string>" Title="@col" Property="@col">
                                    <HeaderTemplate>
                                        <p>@col</p>
                                        <RadzenDropDown Data="AvailableEntityFields"
                                                        TextProperty="Name"
                                                        AllowClear="true"
                                                        AllowFiltering="true"
                                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                        @bind-Value="ColumnMappings[col]"
                                                        Placeholder="Выберите свойство...">
                                            @* Кастомный шаблон для отображения элементов *@
                                            <Template Context="field">
                                                <div style="display:flex; flex-direction:column;">
                                                    <span>@field.Name</span>
                                                    <span style="color:gray; font-size:0.85em;">
                                                        (@field.ShortType) Nullable:@(field.Nullable ? "Yes" : "No")
                                                    </span>
                                                </div>
                                            </Template>
                                        </RadzenDropDown>
                                    </HeaderTemplate>
                                    <Template Context="data">
                                        @data[col]
                                    </Template>
                                </RadzenDataGridColumn>
                            }
                        </Columns>
                    </RadzenDataGrid>
                }
            </div>
        </div>
            }
        </div>
    </div>
</div>
